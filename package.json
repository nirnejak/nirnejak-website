{
  "name": "nirnejak-website",
  "version": "1.0.0",
  "description": "Portfolio website of Jeet Nirnejak",
  "keywords": [
    "nextjs",
    "oxfmt",
    "oxlint",
    "precommit",
    "react",
    "typescript"
  ],
  "homepage": "https://nirnejak.com",
  "bugs": {
    "url": "https://github.com/nirnejak/nirnejak-website/issues"
  },
  "license": "MIT",
  "author": "Jeet Nirnejak <jeetnirnejak@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/nirnejak/nirnejak-website"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "type-check": "next typegen && tsc --pretty --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.4.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "akar-icons": "^1.9.31",
    "cmdk": "^1.1.1",
    "lenis": "^1.3.27",
    "motion": "^14.7.1",
    "next": "^16.4.3",
    "next-view-transitions": "^0.3.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.json": "oxfmt"
  },
  "trustedDependencies": [
    "@vercel/speed-insights"
  ]
}
